<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량(Android Automotive) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />

    <!-- Pleos Vehicle SDK: Odometer -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Pleos Vehicle SDK: Gear (권한 미확정이라 함께 선언) -->
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />

    <!-- Pleos Vehicle 서비스 존재 확인·바인딩 (Android 11+ 패키지 공개 범위) -->
    <queries>
        <package android:name="ai.pleos.playground.service.vehicle" />
    </queries>

    <application
        android:name=".DrivaryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drivary">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Drivary"
            android:windowSoftInputMode="adjustResize">
            <!-- 주행 중(D)에도 화면이 가려지지 않도록 Distraction Optimized로 표시 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 운행기록부 CSV 공유 (res/xml/file_paths.xml) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>